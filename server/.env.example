# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/lms?retryWrites=true&w=majority

# JWT
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Server
PORT=5000
NODE_ENV=development

# CORS - the deployed React app URL (comma-separate multiple origins)
CLIENT_URL=http://localhost:5173

# Seed (used only by seed/seed.js to create the first admin)
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!

# Uploads
MAX_UPLOAD_SIZE_MB=25
